<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>OpenChatRoomCleaner</AssemblyName><RootNamespace>OpenChatRoomCleaner</RootNamespace>
    <OutputPath>bin\Debug\</OutputPath><PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup><Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/></ItemGroup>
  <ItemGroup><Compile Include="Program.cs"/><Compile Include="Vision.cs"/><Compile Include="Workflow.cs"/><Compile Include="Desktop.cs"/></ItemGroup>
  <ItemGroup><Content Include="Assets\*.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
